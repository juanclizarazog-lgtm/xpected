# Copia este archivo como .env y completa tu clave. El servidor lo lee al arrancar;
# nunca se sirve al navegador ni debe subirse a un repositorio.

# Clave de The Odds API (https://the-odds-api.com)
ODDS_API_KEY=

# Competiciones (consulta /api/sports con el servidor en marcha para ver las claves disponibles)
ODDS_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_conmebol_copa_libertadores

# Mercados: cada mercado multiplica el costo. Solo h2h (1X2) gasta la mitad que h2h,totals.
ODDS_MARKETS=h2h,totals

# Región de casas (eu incluye la referencia afilada)
ODDS_REGIONS=eu

# Intervalo mínimo entre consultas, en segundos. El servidor lo alarga solo si los créditos no alcanzan hasta fin de mes.
ODDS_POLL_SECONDS=60

# Por debajo de estos créditos restantes se pausan las consultas
ODDS_MIN_CREDITS=15

# Lista blanca de operadores autorizados por Coljuegos (claves del proveedor, separadas por coma). Vacía = todas anonimizadas.
ODDS_ALLOWED_BOOKS=
